# Copy to .env and fill in. Real environment variables win over this file.
# Never commit .env.

# OpenRouter: the LLM and Jev both go through this key.
OPENROUTER_API_KEY=

# Providers
FIRSTLINE_LLM_PROVIDER=openrouter        # openrouter | fake
FIRSTLINE_LLM_MODEL=                     # an OpenRouter model slug
FIRSTLINE_DECISION_PROVIDER=jev          # jev | bosun | fake
FIRSTLINE_DECISION_MODEL=typesafe/jev-1.13
# FIRSTLINE_BOSUN_URL=http://localhost:8000

# Retrieval
FIRSTLINE_SEARCH_BACKEND=local           # local | azure
# AZURE_SEARCH_ENDPOINT=https://<name>.search.windows.net
# AZURE_SEARCH_KEY=

# Limits
# FIRSTLINE_MAX_STEPS=6
# FIRSTLINE_MAX_SEARCHES=4
# FIRSTLINE_MAX_ISSUE_CHARS=8000
